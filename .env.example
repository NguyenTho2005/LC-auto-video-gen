# ════════════════════════════════════════════════════════════════════════════
# Auto News Video — Environment Configuration
# ════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your real API keys.
# .env.local is gitignored — never commit real keys.

# ════════════════════════════════════════════════════════════════════════════
# LLM Provider (M4 - Script Generation: npm run script)
# ════════════════════════════════════════════════════════════════════════════
# Choose ONE: "gemini" (recommended, Google AI Studio free tier), "openai", "anthropic", or "fake" (for testing)
LLM_PROVIDER=gemini
# API Key for chosen provider (or use GEMINI_API_KEY directly for Gemini):
LLM_API_KEY=
GEMINI_API_KEY=
# Model used by the current Studio setup; availability/quota depend on your account.
LLM_MODEL=gemini-flash-lite-latest
# UI-saved config/llm.json takes precedence over these LLM environment variables.
# Optional base URL override (for OpenAI-compatible providers like Groq, DeepSeek, Ollama):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ── TTS Provider ────────────────────────────────────────────────────────────
# Choose ONE: "edge-tts", "zerotts", "lucylab", "elevenlabs" or "vbee"
# - edge-tts   : Microsoft Edge online TTS (FREE, no API key required, supports VN & SRT)
# - lucylab    : Vietnamese voice cloning (recommended for VN content), free SRT
# - elevenlabs : multilingual, more voice options, higher quality but pricier
# - vbee       : Vietnamese TTS (https://vbee.vn), async polling model
TTS_PROVIDER=edge-tts

# ════════════════════════════════════════════════════════════════════════════
# OPTION 1: Edge TTS (Free - Microsoft Edge TTS via edge-tts-universal)
# ════════════════════════════════════════════════════════════════════════════
# No API key required.
# Vietnamese voices available:
# - vi-VN-HoaiMyNeural (Female)
# - vi-VN-NamMinhNeural (Male  - default)
EDGE_TTS_VOICE=vi-VN-NamMinhNeural
# Legacy CLI rate. Studio selects 1.2x per video; do not add another +20% here.
EDGE_TTS_RATE=+0%
EDGE_TTS_PITCH=+0Hz
EDGE_TTS_VOLUME=+0%

# ════════════════════════════════════════════════════════════════════════════
# OPTION 2: LucyLab.io  (https://lucylab.io)
# ════════════════════════════════════════════════════════════════════════════
# Required when TTS_PROVIDER=lucylab
VIETNAMESE_API_KEY=
VIETNAMESE_VOICEID=

# Optional overrides
LUCYLAB_ENDPOINT=https://api.lucylab.io/json-rpc
LUCYLAB_POLL_INTERVAL_MS=2000
LUCYLAB_POLL_TIMEOUT_MS=120000

# ════════════════════════════════════════════════════════════════════════════
# OPTION 3: ElevenLabs  (https://elevenlabs.io)
# ════════════════════════════════════════════════════════════════════════════
# Required when TTS_PROVIDER=elevenlabs
# Get API key at:  https://elevenlabs.io/app/settings/api-keys
# Browse voices at: https://elevenlabs.io/app/voice-library
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Vietnamese Studio: Flash v2.5 supports Vietnamese. Multilingual v2 does not.
# Legacy CLI default is preserved; new Studio requests choose Flash v2.5.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_ENDPOINT=https://api.elevenlabs.io/v1

# ════════════════════════════════════════════════════════════════════════════
# OPTION 4: Vbee  (https://vbee.vn)
# ════════════════════════════════════════════════════════════════════════════
# Required when TTS_PROVIDER=vbee
# Register at https://vbee.vn to get your app_id and access_token.
VBEE_APP_ID=
VBEE_ACCESS_TOKEN=

# Optional overrides
VBEE_VOICE_CODE=n_hanoi_male_protrainer_education_vc
VBEE_SPEED_RATE=1.0
VBEE_ENDPOINT=https://vbee.vn/api/v1
VBEE_POLL_INTERVAL_MS=2000
VBEE_POLL_TIMEOUT_MS=60000

# ════════════════════════════════════════════════════════════════════════════
# TikTok follow card (outro)
# ════════════════════════════════════════════════════════════════════════════
# Customize the TikTok-style profile card that appears at the end of every video.
# All fields optional — defaults work out of the box.
TIKTOK_DISPLAY_NAME=DevPeek36
TIKTOK_HANDLE=@devpeek36
# Leave empty to hide follower count completely:
TIKTOK_FOLLOWERS=

# Optional: URL to your real TikTok avatar image (jpg/png, square, ~256x256+).
# If not set, uses the bundled default avatar at assets/avatar.jpg.
# You can also replace assets/avatar.jpg directly with your own image.
# TIKTOK_AVATAR_URL=https://example.com/your-avatar.jpg

# ── Pipeline tuning ─────────────────────────────────────────────────────────
# TTS_CONCURRENCY: Concurrency limit for TTS generation (e.g. 1-3)
TTS_CONCURRENCY=1

# ════════════════════════════════════════════════════════════════════════════
# Visual theme
# ════════════════════════════════════════════════════════════════════════════
# Choose ONE: "dark-neon" (default) or "light-pro"
# - dark-neon : navy/cyan/purple, glow effects — original look
# - light-pro : white/slate/indigo, clean corporate look, no neon/grain
# Each channel/brand can pin its own value in a separate .env if desired.
VIDEO_THEME=dark-neon

# New web Studio uses per-video voice settings; API credentials stay server-side.
# MP3/WAV upload mode works without TTS API keys.

# Optional local ZeroTTS (install once: npm run zerotts:setup)
ZEROTTS_VOICE=quangminh
ZEROTTS_PORT=7821

# AI News Radar: optional credentials, never sent to the browser.
# Public RSS/API discovery works without these. Authenticated requests never follow redirects.
RADAR_GITHUB_TOKEN=
# OAuth access token granted by Reddit; subject to Reddit's access policy and expiration.
REDDIT_ACCESS_TOKEN=
# X read/search API access may require a paid plan; disabled until configured.
X_BEARER_TOKEN=
# Comma-separated public Telegram channel usernames (no @). No private groups.
RADAR_TELEGRAM_CHANNELS=
